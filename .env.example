# ─── SmartFM LMS Backend Configuration ─────────────────────────────────────────

# Server
APP_ENV=development
APP_PORT=8080
APP_NAME=smartfm-lms

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=lms
DB_PASSWORD=lms_secret
DB_NAME=smartfm_lms
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production-this-is-not-secure
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_RAW_BUCKET=lms-raw-videos
MINIO_HLS_BUCKET=lms-hls-videos
MINIO_THUMBNAILS_BUCKET=lms-thumbnails
# Base URL browsers use to stream HLS + load thumbnails (CDN in production)
MINIO_PUBLIC_URL=http://localhost:9000

# Kafka
KAFKA_BROKERS=localhost:9092

# ClickHouse (native port as mapped in docker-compose.yml)
CLICKHOUSE_ADDR=localhost:9004
CLICKHOUSE_USER=lms
CLICKHOUSE_PASSWORD=lms_secret
CLICKHOUSE_DB=smartfm_analytics

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
